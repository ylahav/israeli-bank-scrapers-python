# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Virtual environments — never commit one of these; requirements*.txt is
# the source of truth for dependencies
.venv/
venv/
env/

# Credentials / local secrets — never commit real values. If you make a
# local copy of TESTING_COMMANDS.md with real credentials filled in, name
# it with a -local suffix so it's ignored automatically:
.env
.env.*
TESTING_COMMANDS-local.md
*-local.md

# Build artifacts (see build/cli.spec — dist/ is regenerated by
# build/build.py, never hand-edited or committed)
build/work/
dist/

# Runtime artifacts from testing
failure_screenshot.png

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
